{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shardbound:deck:v0.1",
  "title": "Shardbound deck",
  "description": "One deck per file: content/decks/<id>.json. Deck-building rules that need the card data (30 cards, one faction + neutrals, at most 2 copies, no tokens: rulebook section 2) are checked by the content tests.",
  "type": "object",
  "required": ["id", "name", "faction", "cards"],
  "properties": {
    "id": {
      "description": "Stable identifier, equal to the file name without .json.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "faction": {
      "description": "The deck's faction. Neutral cards are always allowed on top of it (2.2).",
      "enum": ["ember", "tide", "root"]
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "card": {
            "description": "Card id, e.g. ember.ash-warden.",
            "type": "string",
            "pattern": "^(ember|tide|root|neutral)\\.[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "count": {
            "description": "Number of copies (2.3).",
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          }
        },
        "required": ["card", "count"],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
